# Normalize text to LF (Unity expects LF; avoids CRLF churn and warnings).
unity/**/*.cs    text eol=lf
unity/**/*.unity text eol=lf
unity/**/*.prefab text eol=lf
unity/**/*.asset text eol=lf
unity/**/*.mat   text eol=lf
unity/**/*.controller text eol=lf
unity/**/*.meta  text eol=lf
unity/**/*.json  text eol=lf
unity/**/*.shader text eol=lf
unity/**/*.txt   text eol=lf
unity/**/*.uss   text eol=lf
unity/**/*.wlt   text eol=lf
unity/**/*.inputactions text eol=lf

# Git LFS: large Unity binary assets are stored as pointers in git history
# and their real bytes live in the Git LFS store. Scoped to unity/** so the
# Android/Gradle tree is unaffected.
unity/**/*.png  filter=lfs diff=lfs merge=lfs -text
unity/**/*.fbx  filter=lfs diff=lfs merge=lfs -text
unity/**/*.anim filter=lfs diff=lfs merge=lfs -text
unity/**/*.pdf  filter=lfs diff=lfs merge=lfs -text
unity/**/*.jpg  filter=lfs diff=lfs merge=lfs -text
unity/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
unity/**/*.tga  filter=lfs diff=lfs merge=lfs -text
unity/**/*.psd  filter=lfs diff=lfs merge=lfs -text
unity/**/*.exr  filter=lfs diff=lfs merge=lfs -text
unity/**/*.hdr  filter=lfs diff=lfs merge=lfs -text
unity/**/*.dds  filter=lfs diff=lfs merge=lfs -text
unity/**/*.wav  filter=lfs diff=lfs merge=lfs -text
unity/**/*.mp3  filter=lfs diff=lfs merge=lfs -text
unity/**/*.ogg  filter=lfs diff=lfs merge=lfs -text